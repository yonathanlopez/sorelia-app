{
  "name": "Calendar",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "person",
        "goal",
        "important_date",
        "reminder",
        "preference",
        "life_event"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "google_event_id": {
      "type": "string"
    },
    "all_day": {
      "type": "boolean"
    },
    "location": {
      "type": "string"
    },
    "calendar_name": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ]
    },
    "date_type": {
      "type": "string"
    },
    "person_birthday": {
      "type": "string"
    },
    "person_relationship": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}
